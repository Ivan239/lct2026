# --- Модель с открытыми весами (требование кейса: Apache 2.0 / MIT, до 35B) ---
# Любой OpenAI-совместимый endpoint. Решение сдано на Cloud.ru Foundation Models:
LLM_BASE_URL=https://foundation-models.api.cloud.ru/v1
LLM_MODEL=Qwen/Qwen3-32B
LLM_API_KEY=
# Свой vLLM: LLM_BASE_URL=http://localhost:8000/v1, LLM_MODEL=Qwen/Qwen2.5-32B-Instruct
# LLM_VERIFY_SSL=0 — только для самоподписанного сертификата локального сервера

# --- Запасной провайдер разработки (используется, только если LLM_BASE_URL пуст) ---
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
